# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=123456789

# Google Gemini (Asosiy AI)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (Ixtiyoriy muqobil)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Ovoz (TTS)
TTS_VOICE_UZBEK=uz-UZ-MadinaNeural

# Database
DATABASE_URL=sqlite+aiosqlite:///bot.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Token Limits
CHAT_MAX_TOKENS=1500
SUMMARY_MAX_TOKENS=2000
WRITER_MAX_TOKENS=2500
DECISION_MAX_TOKENS=2000
CODE_MAX_TOKENS=2500
EDUCATION_MAX_TOKENS=2000
ENTERTAINMENT_MAX_TOKENS=1500

# Rate Limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# File limits
MAX_FILE_SIZE_MB=20
MAX_PDF_PAGES=50
DEFAULT_TIMEZONE=Asia/Tashkent
