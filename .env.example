# Telegram Bot sozlamalari
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=123456789

# OpenAI sozlamalari
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Ma'lumotlar bazasi (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_bot_db

# Redis kesh va FSM
REDIS_URL=redis://localhost:6379/0

# Token limitlari (Xarajat nazorati)
CHAT_MAX_TOKENS=1000
SUMMARY_MAX_TOKENS=1500
WRITER_MAX_TOKENS=2000
DECISION_MAX_TOKENS=1500
CODE_MAX_TOKENS=2000
EDUCATION_MAX_TOKENS=1500
ENTERTAINMENT_MAX_TOKENS=1000

# Rate Limiting (Redis orqali)
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Hujjat va Ovoz cheklovlari
MAX_FILE_SIZE_MB=20
MAX_PDF_PAGES=50

# Standart vaqt mintaqasi
DEFAULT_TIMEZONE=Asia/Tashkent
